APP_NAME=ITBbot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# The panel and the bot are Persian-only
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bale_exam_bot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# set to true in production (HTTPS)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Anonymous exam bot (see docs/features/anonymous-exam.md)
# The token lives ONLY here; never commit a real value.
# Leaked? Get a new one from @botfather in Bale.
# ---------------------------------------------------------------------------
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=ITBbot
BALE_BASE_URL=https://tapi.bale.ai
# polling (local, no public URL) | webhook (host with HTTPS)
BALE_UPDATE_MODE=polling
BALE_WEBHOOK_SECRET=
# getchatmember | callback | manual
BALE_MEMBERSHIP_MODE=getchatmember
# url | callback | both
BALE_JOIN_BUTTON=both

# Generated once by "php artisan exam:env-setup"; NEVER change it afterwards
ANON_HMAC_SECRET=
ANON_TOKEN_TTL_MINUTES=20
ANON_MIN_RESPONSES=5
ANON_POOL_MODE=false

# Public base URL for participant links (empty = APP_URL)
EXAM_PUBLIC_URL=
# Port used by start.bat for "artisan serve" (falls back to the next free port)
EXAM_PORT=8000
# Display timezone only; the database always stores UTC
APP_TIMEZONE=Asia/Tehran
